# Root-level .env — override defaults here if needed locally
# Backend and frontend each have their own .env files; this root file
# is provided for reference and is not loaded by any service directly.

# Backend defaults (copy to backend/.env)
# PORT=4000
# FAKE_STORE_BASE_URL=https://fakestoreapi.com
# SALES_EMAIL=sales@example.com
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Frontend defaults (copy to frontend/.env)
# VITE_API_URL=http://localhost:4000/api
